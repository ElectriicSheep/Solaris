component hullContact_2S7P
% Outer-row cells to the aluminium hull, one 2S7P slice (8 of 14 cells touch the hull side).
% Generated 2026-11-09 from topology_slice_2S7P_rev2.csv. Outer row = cells on the 63.7 mm ring.
% Port H: the module's CPB port (model cell order). Port Hull: the hull node.
% Outer model indices: 1 2 4 6 8 9 11 14 (CSV 6 3 2 1 9 12 13 14).
% R is a PLACEHOLDER: 2.00 mm cell-to-hull gap through PLA (k = 0.2 W/m/K),
% 5 mm wide strip, full cell height. Contact quality and any air gap are unknown.

parameters
    R = {30.7, 'K/W'}; % Cell-to-hull thermal resistance, per outer cell
end

for i = 1:14
    nodes
        H(i) = foundation.thermal.thermal; % H:top
    end
end

nodes
    Hull = foundation.thermal.thermal; % Hull:bottom
end

for k = 1:8
    components(ExternalAccess = observe)
        contact(k) = foundation.thermal.elements.resistance(resistance = R);
    end
end

connections
    connect(contact(1).A, H(1)); connect(contact(1).B, Hull);
    connect(contact(2).A, H(2)); connect(contact(2).B, Hull);
    connect(contact(3).A, H(4)); connect(contact(3).B, Hull);
    connect(contact(4).A, H(6)); connect(contact(4).B, Hull);
    connect(contact(5).A, H(8)); connect(contact(5).B, Hull);
    connect(contact(6).A, H(9)); connect(contact(6).B, Hull);
    connect(contact(7).A, H(11)); connect(contact(7).B, Hull);
    connect(contact(8).A, H(14)); connect(contact(8).B, Hull);
end

end
