* text=auto

*.fig binary
*.mat binary
*.mdl binary diff merge=mlAutoMerge
*.mex* binary
*.mlapp binary
*.mldatx binary merge=mlAutoMerge
*.mlproj binary
*.mlx binary
*.p binary
*.plprj binary
*.psprjx binary merge=mlAutoMerge
*.sbproj binary
*.sfx binary
*.sldd binary diff merge=mlAutoMerge
*.slreqx binary merge=mlAutoMerge
*.slmx binary merge=mlAutoMerge
*.sltx binary
*.slxc binary
*.slx binary merge=mlAutoMerge
*.slxp binary

## MATLAB Project metadata files use LF line endings
/resources/project/**/*.xml text eol=lf

## Other common binary file types
*.docx binary
*.exe binary
*.jpg binary
*.pdf binary
*.png binary
*.xlsx binary
# Pi sources are built on Linux: keep LF line endings
"12. AFE/**" text eol=lf
"13. Pi/**" text eol=lf
*.dbc text eol=lf

## Binary types must override the folder text rules above (last match wins)
*.slx binary -eol merge=mlAutoMerge
*.sldd binary -eol merge=mlAutoMerge
*.mex* binary -eol
*.mat binary -eol
*.mlx binary -eol
*.mlapp binary -eol
*.fig binary -eol
*.slxc binary -eol
*.png binary -eol
*.jpg binary -eol
*.pdf binary -eol
